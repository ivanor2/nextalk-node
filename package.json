{
  "name": "nextalk-node",
  "version": "3.0.0",
  "description": "NexTalk WebSocket Node — независимый узел передачи сообщений (SQLite, zero-install)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js 3001",
    "setup:node": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-local-node.ps1",
    "docker:build": "docker build -t nextalk-node .",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:cluster": "docker compose --profile cluster up -d",
    "docker:dev": "docker compose -f docker-compose.yml -f docker-compose.dev.yml up"
  },
  "keywords": [
    "websocket",
    "messenger",
    "nextalk",
    "sqlite",
    "docker"
  ],
  "license": "MIT",
  "dependencies": {
    "dotenv": "^18.0.4",
    "localtunnel": "^2.0.2",
    "ws": "^8.18.0"
  }
}
