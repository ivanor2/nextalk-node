# NexTalk Node Configuration
PORT=3001
NODE_NAME="Your Node Name"

# Режим Node.js (true = портативный Node.js из папки .node с авто-скачиванием; false = системный Node.js)
USE_LOCAL_NODE=true
LOCAL_NODE_DIR=".node"
NODE_VERSION="v22.13.0"

# JWT Configuration (Must match nextalk-auth)
JWT_ISSUER="nextalk-auth"
JWT_TTL=604800

# SQLite Database (auto-created, no external DB server needed)
# DB_PATH="./data/nextalk.db"

# LocalTunnel (public access via loca.lt)
LOCALTUNNEL_ENABLED=false
LOCALTUNNEL_SUBDOMAIN="my-nextalk"

# Адрес сервера авторизации (если узел запускается на телефоне/другом ПК)
# По умолчанию: http://nextalk-auth
# AUTH_URL="http://192.168.1.55/nextalk-auth"
